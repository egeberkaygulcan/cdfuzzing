# Sanity check: aflpluspluscd on 3 diverse targets, 4h, production parameters.
# Goal: verify drift fires at least once per target with real settings (not the
# aggressive smoke-test overrides), and that no crashes occur.
# Targets: libpng (simple), php (complex/stateful), sqlite3 (medium).
WORKDIR=/users/eldarfin/experiment_results/sanity
REPEAT=1
TIMEOUT=4h
POLL=5
CACHE_ON_DISK=1
NO_ARCHIVE=1
MAGMA=/users/eldarfin/cdfuzzing/magma

FUZZERS=(aflpluspluscd)

aflpluspluscd_TARGETS=(libpng php sqlite3)

# Production drift parameters (same as captainrc_batch1)
export AFL_DRIFT_WINDOW=100
export AFL_DRIFT_THRESHOLD=0.05
export AFL_DRIFT_SOFT_RESET=2
export AFL_DRIFT_MAX_RESETS=0
export AFL_DRIFT_HAVOC_BOOST=2
export AFL_DRIFT_BOOST_CYCLES=1
export AFL_DRIFT_COOLDOWN=10
export AFL_DRIFT_CONSECUTIVE=5
export AFL_DRIFT_EMA_ALPHA=0.1
export AFL_DRIFT_STAGNATION_FACTOR=0.5
